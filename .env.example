# ===== 기상청 API허브 (필수) =====
# https://apihub.kma.go.kr > 마이페이지 > 인증키. URL 인코딩 없이 원문 그대로. data.go.kr serviceKey, VWorld 키와 다릅니다.
KMA_API_KEY=

# 수집기 설정 (기본값 그대로 사용 가능)
KMA_TIMEOUT_SECONDS=30
KMA_MAX_ATTEMPTS=3
KMA_POLL_SECONDS=300
KMA_LAG_MINUTES=20
KMA_ACCUMULATION_MINUTES=60

# ===== 외부 자료 (선택, 1순위 자료용). 비워 두면 해당 수집기는 안내만 출력하고 종료합니다 =====
# Copernicus Climate Data Store (ERA5·ERA5-Land 원자료, 1순위). https://cds.climate.copernicus.eu > 로그인 > 프로필의 "Personal Access Token"
# 사용: Geo Data Analyst/scripts/external/fetch_cds_era5.py  (pip install cdsapi 필요)
CDS_API_KEY=

# NASA Earthdata (MODIS MOD07/MOD11/MCD43, AppEEARS 점 요청). https://urs.earthdata.nasa.gov 계정의 ID·비밀번호
# 사용: external/fetch_earthdata_modis.py
EARTHDATA_USER=
EARTHDATA_PASS=

# Copernicus Data Space Ecosystem (Sentinel-3 SLSTR LST). https://dataspace.copernicus.eu > 계정 > OAuth 클라이언트 생성
# 사용: external/fetch_cdse_sentinel3.py
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# 공공데이터포털 serviceKey (환경부·산림청 Open API 보조). https://www.data.go.kr > 마이페이지 > 인증키 (Decoding 키)
DATA_GO_KR_KEY=

# 국가기상위성센터 (천리안 2A 과거 산출물 신청 후 발급). https://nmsc.kma.go.kr  — 현재분은 API허브 키로 받으므로 과거 자료에만 필요
NMSC_API_KEY=

# 로그인 다운로드가 필요한 SHP 자료는 받은 파일의 로컬 경로를 적습니다 (저장소에 넣지 않음)
# 환경부 세분류 토지피복도 (https://egis.me.go.kr): 제주 전 도엽을 하나의 폴더에 두고 폴더 또는 .shp 경로
ME_LANDCOVER_SHP=
# 산림청 임상도 1:5,000 (https://map.forest.go.kr)
FGIS_FOREST_SHP=

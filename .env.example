# Paste the original KMA API Hub key here, without URL encoding.
# This key is different from a data.go.kr serviceKey or VWorld key.
KMA_API_KEY=

# All remaining settings are ready to use. No request runs merely by saving this file.
KMA_TIMEOUT_SECONDS=30
KMA_MAX_ATTEMPTS=3
KMA_POLL_SECONDS=300
KMA_LAG_MINUTES=20
KMA_ACCUMULATION_MINUTES=60
